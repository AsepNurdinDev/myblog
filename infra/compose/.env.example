# Copy to infra/compose/.env and replace every CHANGE_ME value. Never commit it.

# Deployment guard: deploy.sh refuses another checked-out branch.
DEPLOY_BRANCH=feature/laravel-api-v1
TZ=Asia/Makassar

# Only the NEXUS-hosted cloudflared service should connect to this loopback port.
NGINX_BIND_IP=127.0.0.1
NGINX_HTTP_PORT=8080

# Laravel production configuration
APP_NAME=MyBlog
APP_ENV=production
APP_KEY=base64:CHANGE_ME_GENERATE_WITH_php_artisan_key_generate_show
APP_DEBUG=false
APP_URL=https://api.asepblog.online
LOG_LEVEL=warning
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# MySQL creates these values only when myblog_mysql_data is brand new.
# Restore an existing dump into a newly-created volume before deploying backend.
MYSQL_DATABASE=myblog
MYSQL_USER=myblog
MYSQL_PASSWORD=CHANGE_ME_LONG_UNIQUE_APP_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_LONG_UNIQUE_ROOT_PASSWORD

# Kept for the future Next.js profile.
NEXT_PUBLIC_API_URL=https://api.asepblog.online
FRONTEND_ENABLED=false

# Explicitly set true only when intentionally starting a brand-new EMPTY database.
ALLOW_EMPTY_DATABASE=false
