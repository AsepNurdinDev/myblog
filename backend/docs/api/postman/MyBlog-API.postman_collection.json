    {
      "name": "Homepage",
      "item": [
        {
          "name": "Get homepage",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is JSON', function () { pm.response.to.be.json; });",
                  "const j = pm.response.json();",
                  "pm.test('Check 1', function () { pm.expect(j.data).to.have.keys('profile','latest_posts','latest_projects','categories'); });",
                  "pm.test('Check 2', function () { pm.expect(j.data.latest_posts.length).to.be.at.most(6); });",
                  "pm.test('Check 3', function () { pm.expect(j.data.latest_projects.length).to.be.at.most(3); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "description": "Profile, latest 6 published articles, latest 3 projects and all categories.\n\nExpected status: 200",
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/home",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "{{api_version}}",
                "home"
              ],
              "query": []
            }
          },
          "response": []
        }
      ]
    },
